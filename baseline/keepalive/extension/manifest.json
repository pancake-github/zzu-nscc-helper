{
  "manifest_version": 3,
  "name": "SSL VPN 助手 · Edge 标签页连接器",
  "version": "0.4.0",
  "description": "将 Edge 标签页列表交给本机助手；仅在手动绑定后尝试恢复关闭的超算标签页。",
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "alarms",
    "webNavigation",
    "scripting"
  ],
  "host_permissions": [
    "https://172.99.2.7/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "连接桌面 SSL VPN 助手"
  },
  "incognito": "not_allowed"
}